# Secrets (k8s: ExternalSecret tg-garmin-to-osm-secrets; keys are named
# tg-garmin-to-osm__tg-garmin-to-osm-secrets__<KEY>)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=          # the OPERATOR chat: service warnings go there; users talk to the bot directly
OSM_CLIENT_ID=             # OAuth 2 app: https://www.openstreetmap.org/oauth2/applications/new (confidential,
                           # redirect urn:ietf:wg:oauth:2.0:oob, scopes read_prefs read_gpx write_gpx)
OSM_CLIENT_SECRET=
# Optional
TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org
OSM_BASE_URL=https://www.openstreetmap.org   # master.apis.dev.openstreetmap.org for dry runs
GARMINTOKENS=~/.garminconnect                # BASE dir: per-user stores live in GARMINTOKENS/<telegram_uid>/
DATA_DIR=./data
DEFAULT_TYPES=bike         # default /types for new users: groups bike|run|walk|water|winter|fitness or raw keys
VISIBILITY=identifiable    # default visibility for new users (identifiable | trackable)
UPLOAD_DELAY_MINUTES=0     # window between noticing a ride and uploading it, time to /skip it
TRACE_TAGS=bike
SCAN_PAGE=10               # activities fetched per user per scan (newest first)
GARMIN_POLL_SECONDS=600    # scan cadence per user: one light page, deliberate politeness
TRACE_CHECK_SECONDS=300    # how often pending OSM traces are checked for processing
INGEST_TOKEN=             # cluster-internal bearer for the ingest API; the web site relays links with it
INGEST_PORT=8080
LINK_SITE=https://garmin-osm.exiosv.com
# Legacy single-account bootstrap (not needed; users link via the web site):
GARMIN_EMAIL=
GARMIN_PASSWORD=
